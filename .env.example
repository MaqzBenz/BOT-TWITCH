# ============ CocoBot - configuration (copier vers .env) ============

# --- Réseau ---
# Port d'écoute du dashboard (plage 12000-13000). Utilisé aussi pour le mapping Docker.
APP_PORT=12080

# --- Sécurité du dashboard ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
# Option A (recommandée) : hash Argon2. Générer : docker compose run --rm cocobot python -m app.hash_password
ADMIN_PASSWORD_HASH=
# Option B : mot de passe en clair (>= 12 caractères), haché en mémoire au démarrage. Ignoré si le hash est défini.
ADMIN_PASSWORD=
# Accès en HTTP : false. (true = cookie "Secure", HTTPS obligatoire, sauf localhost.)
COOKIE_SECURE=false

# --- Twitch ---
# Console développeur : https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=d1iaauyq878qnq9pu1bnd7chxyujpb
TWITCH_CLIENT_SECRET=c0fgh5ihpfmsaea1h6vj99rnrbt17g
# Token utilisateur du compte bot (avec ou sans le préfixe oauth:)
TWITCH_BOT_TOKEN=
# Refresh token (optionnel mais recommandé : renouvellement automatique)
TWITCH_REFRESH_TOKEN=
# Première chaîne (optionnel) : utilisée une seule fois pour initialiser la liste.
# Ensuite, ajoutez/retirez des chaînes depuis le dashboard (onglet « Chaînes »).
TWITCH_CHANNEL=

LOG_LEVEL=INFO
